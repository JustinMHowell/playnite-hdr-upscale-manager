<UserControl x:Class="HdrUpscaleManager.UI.ManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:HdrUpscaleManager.UI">
    <UserControl.Resources>
        <local:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVis"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="SectionBorder" TargetType="Border">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#33808080"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="SectionStatus" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#BFBFBF"/>
            <Setter Property="Margin" Value="0,2,0,8"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Padding" Value="10,4"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding GameName}" FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="1" Text="{Binding StatusText}" Foreground="#66B2FF" FontSize="13" Margin="0,0,0,16" TextWrapping="Wrap"/>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource SectionBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="ReShade" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="{Binding ReShadeStatus}" Style="{StaticResource SectionStatus}"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Install latest" Command="{Binding ReShadeInstallCommand}" AutomationProperties.AutomationId="ReShadeInstall"/>
                                <Button Content="Uninstall" Command="{Binding ReShadeUninstallCommand}" AutomationProperties.AutomationId="ReShadeUninstall"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Column="1" Width="1" Background="#33808080" Margin="14,0"/>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="OS HDR toggle on launch/exit" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Unverified — validate on your own display before relying on it."
                                       Style="{StaticResource SectionStatus}"/>
                            <CheckBox Content="Enable for this game" IsChecked="{Binding HdrToggleEnabled}" Foreground="White" AutomationProperties.AutomationId="HdrToggleEnabled"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SectionBorder}">
                    <StackPanel>
                        <TextBlock Text="RenoDX" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{Binding RenoDxStatus}" Style="{StaticResource SectionStatus}"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Install" Command="{Binding RenoDxInstallCommand}" AutomationProperties.AutomationId="RenoDxInstall"/>
                            <Button Content="Check update" Command="{Binding RenoDxUpdateCommand}" AutomationProperties.AutomationId="RenoDxCheckUpdate"/>
                            <Button Content="Uninstall" Command="{Binding RenoDxUninstallCommand}" AutomationProperties.AutomationId="RenoDxUninstall"/>
                            <Button Content="Open link" Command="{Binding OpenRenoDxExternalUrlCommand}" AutomationProperties.AutomationId="RenoDxOpenLink"
                                    Visibility="{Binding RenoDxExternalUrl, Converter={StaticResource StringNotEmptyToVis}}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding RenoDxEngineDetectionText}" Style="{StaticResource SectionStatus}" Margin="0,8,0,4"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Unreal Engine, generic" Command="{Binding RenoDxInstallUnrealGenericCommand}" AutomationProperties.AutomationId="RenoDxInstallUnrealGeneric"
                                    IsEnabled="{Binding CanInstallUnrealRenoDx}" Visibility="{Binding CanInstallUnrealRenoDx, Converter={StaticResource BoolToVis}}"/>
                            <Button Content="Unreal Engine, UE-Extended" Command="{Binding RenoDxInstallUnrealUeExtendedCommand}" AutomationProperties.AutomationId="RenoDxInstallUnrealUeExtended"
                                    IsEnabled="{Binding CanInstallUnrealRenoDx}" Visibility="{Binding CanInstallUnrealRenoDx, Converter={StaticResource BoolToVis}}"/>
                            <Button Content="Unity, generic" Command="{Binding RenoDxInstallUnityCommand}" AutomationProperties.AutomationId="RenoDxInstallUnity"
                                    IsEnabled="{Binding CanInstallUnityRenoDx}" Visibility="{Binding CanInstallUnityRenoDx, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionBorder}">
                    <StackPanel>
                        <TextBlock Text="Luma" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{Binding LumaStatus}" Style="{StaticResource SectionStatus}"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Install" Command="{Binding LumaInstallCommand}" AutomationProperties.AutomationId="LumaInstall"/>
                            <Button Content="Check update" Command="{Binding LumaUpdateCommand}" AutomationProperties.AutomationId="LumaCheckUpdate"/>
                            <Button Content="Uninstall" Command="{Binding LumaUninstallCommand}" AutomationProperties.AutomationId="LumaUninstall"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionBorder}" Visibility="{Binding ShowDxvkSection, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="DXVK+Lilium HDR" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{Binding DxvkStatus}" Style="{StaticResource SectionStatus}"/>
                        <TextBlock Text="{Binding DxvkApiDetectionText}" Style="{StaticResource SectionStatus}"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Install (DX8/DX9/DX10)" Command="{Binding DxvkInstallCommand}" AutomationProperties.AutomationId="DxvkInstall"
                                    IsEnabled="{Binding CanInstallDxvk}" Visibility="{Binding ShowDxvkInstallButton, Converter={StaticResource BoolToVis}}"/>
                            <Button Content="Check update" Command="{Binding DxvkUpdateCommand}" AutomationProperties.AutomationId="DxvkCheckUpdate"/>
                            <Button Content="Uninstall" Command="{Binding DxvkUninstallCommand}" AutomationProperties.AutomationId="DxvkUninstall"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionBorder}">
                    <StackPanel>
                        <TextBlock Text="OptiScaler (AMD)" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{Binding OptiScalerStatus}" Style="{StaticResource SectionStatus}"/>
                        <TextBlock Text="{Binding OptiScalerWikiCompatText}" Style="{StaticResource SectionStatus}" AutomationProperties.AutomationId="OptiScalerWikiCompatText"/>
                        <TextBlock Text="Check the game's own graphics settings: if it already offers FSR or XeSS (any version), use 'has FSR/XeSS'. If it only offers DLSS, use 'DLSS-only game'."
                                   Style="{StaticResource SectionStatus}"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Install (DLSS-only game)" Command="{Binding OptiScalerInstallDlssCommand}" AutomationProperties.AutomationId="OptiScalerInstallDlss"/>
                            <Button Content="Install (has FSR/XeSS)" Command="{Binding OptiScalerInstallNoDlssCommand}" AutomationProperties.AutomationId="OptiScalerInstallNoDlss"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="Check update" Command="{Binding OptiScalerUpdateCommand}" AutomationProperties.AutomationId="OptiScalerCheckUpdate"/>
                            <Button Content="Uninstall" Command="{Binding OptiScalerUninstallCommand}" AutomationProperties.AutomationId="OptiScalerUninstall"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
