<UserControl x:Class="HdrUpscaleManager.UI.ManagerFullscreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:HdrUpscaleManager.UI">
    <!--
        Fullscreen-mode counterpart to ManagerView.xaml. Playnite's Fullscreen host window for
        plugin content (via IDialogsFactory.CreateWindow) renders chromeless/transparent, so this
        view supplies its own fully opaque backdrop and a hardcoded high-contrast palette rather
        than any theme DynamicResource — same approach validated in playnite-eden-mod-manager's
        Fullscreen view, reused here rather than re-deriving a new untested palette.

        Gamepad: real WPF Button/CheckBox controls get D-pad-as-arrow-keys focus movement for
        free from Playnite's Fullscreen input layer. What's still needed by hand: setting initial
        focus on Loaded (the host doesn't do it), auto-scrolling the focused control into view on
        arrow keys (nothing does this by default), and routing gamepad A/B — which arrive via
        GenericPlugin.OnControllerButtonStateChanged, not as WPF key events — through
        FocusActivation (see ManagerFullscreenView.xaml.cs and HdrUpscaleManagerPlugin.cs).
    -->
    <UserControl.Resources>
        <local:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVis"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="FsButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="#FF2A2E36" BorderBrush="#33FFFFFF" BorderThickness="2" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#FFE0BE79"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FF383D47"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FsToggle" TargetType="CheckBox">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Bg" Background="#FF23262C" BorderBrush="Transparent" BorderThickness="3" CornerRadius="10" Padding="16,10">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="Check" Width="22" Height="22" BorderThickness="2" BorderBrush="#88FFFFFF" CornerRadius="4" Margin="0,0,12,0">
                                    <Path x:Name="CheckMark" Data="M2,8 L7,13 L16,3" Stroke="#FF6FCF7A" StrokeThickness="3" Visibility="Collapsed"/>
                                </Border>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FF2A3F2E"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#FF6FCF7A"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#FFE0BE79"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FsToggleButton" TargetType="ToggleButton">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Content" Value="Disabled"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bg" Background="#FF23262C" BorderBrush="Transparent" BorderThickness="3" CornerRadius="10" Padding="16,10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FF2A3F2E"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#FF6FCF7A"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#FFE0BE79"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Content" Value="Enabled"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="False">
                    <Setter Property="Content" Value="Disabled"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FsSectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="FsSectionStatus" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="#CCFFFFFF"/>
            <Setter Property="Margin" Value="0,4,0,12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Resources>

    <Border Background="#FF15171B" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="15">
        <Grid Margin="36">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,16" LastChildFill="True">
                <!-- Docked right, declared first so the title StackPanel (last child, undocked)
                     fills the remaining space per LastChildFill rather than trailing it. Which
                     set is visible is decided by ManagerViewModel.RefreshGamepadIconStyle (see
                     GamepadIconStyleDetector) — Playnite has no controller-brand API, so this is
                     a best-effort guess from the connected device's name, defaulting to Xbox.
                     Icons: Kenney Input Prompts (CC0, kenney.nl). -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding IsXboxGamepadIcons, Converter={StaticResource BoolToVis}}">
                        <Image Source="pack://application:,,,/HdrUpscaleManager;component/Resources/GamepadIcons/xbox_a.png" Width="22" Height="22" Margin="0,0,4,0"/>
                        <TextBlock Text="confirm" Foreground="#88FFFFFF" FontSize="16" VerticalAlignment="Center" Margin="0,0,16,0"
                                   AutomationProperties.AutomationId="GamepadHintXbox"/>
                        <Image Source="pack://application:,,,/HdrUpscaleManager;component/Resources/GamepadIcons/xbox_b.png" Width="22" Height="22" Margin="0,0,4,0"/>
                        <TextBlock Text="close" Foreground="#88FFFFFF" FontSize="16" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding IsPlayStationGamepadIcons, Converter={StaticResource BoolToVis}}">
                        <Image Source="pack://application:,,,/HdrUpscaleManager;component/Resources/GamepadIcons/playstation_a.png" Width="22" Height="22" Margin="0,0,4,0"/>
                        <TextBlock Text="confirm" Foreground="#88FFFFFF" FontSize="16" VerticalAlignment="Center" Margin="0,0,16,0"
                                   AutomationProperties.AutomationId="GamepadHintPlayStation"/>
                        <Image Source="pack://application:,,,/HdrUpscaleManager;component/Resources/GamepadIcons/playstation_b.png" Width="22" Height="22" Margin="0,0,4,0"/>
                        <TextBlock Text="close" Foreground="#88FFFFFF" FontSize="16" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding GameName}" FontSize="32" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Text="  •  HDR &amp; Upscale Manager" FontSize="18" Foreground="#88FFFFFF" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                </StackPanel>
            </DockPanel>

            <TextBlock Grid.Row="1" Text="{Binding StatusText}" Foreground="#FFE0BE79" FontSize="19" Margin="0,0,0,16" TextWrapping="Wrap"/>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="ReShade" Style="{StaticResource FsSectionTitle}"/>
                            <TextBlock Text="{Binding ReShadeStatus}" Style="{StaticResource FsSectionStatus}"/>
                            <CheckBox Content="Installed" Style="{StaticResource FsToggle}"
                                      IsChecked="{Binding IsReShadeInstalled, Mode=OneWay}"
                                      Checked="ReShadeToggle_Checked" Unchecked="ReShadeToggle_Unchecked"
                                      AutomationProperties.AutomationId="ReShadeToggle"/>
                        </StackPanel>

                        <Border Grid.Column="1" Width="2" Background="#33FFFFFF" Margin="20,0"/>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="OS HDR toggle on launch/exit" Style="{StaticResource FsSectionTitle}"/>
                            <TextBlock Text="Unverified — validate on your own display before relying on it."
                                       Style="{StaticResource FsSectionStatus}"/>
                            <ToggleButton Style="{StaticResource FsToggleButton}" IsChecked="{Binding HdrToggleEnabled}" AutomationProperties.AutomationId="HdrToggleEnabled"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="RenoDX" Style="{StaticResource FsSectionTitle}"/>
                            <TextBlock Text="{Binding RenoDxStatus}" Style="{StaticResource FsSectionStatus}"/>
                            <WrapPanel Margin="0,0,0,8">
                                <CheckBox Content="Installed" Style="{StaticResource FsToggle}" Margin="0,0,20,10"
                                          IsChecked="{Binding IsRenoDxInstalled, Mode=OneWay}"
                                          Checked="RenoDxToggle_Checked" Unchecked="RenoDxToggle_Unchecked"
                                          AutomationProperties.AutomationId="RenoDxToggle"/>
                                <Button Content="Check update" Style="{StaticResource FsButton}" Command="{Binding RenoDxUpdateCommand}" AutomationProperties.AutomationId="RenoDxCheckUpdate" Margin="0,0,10,10"/>
                                <Button Content="Open link" Style="{StaticResource FsButton}" Command="{Binding OpenRenoDxExternalUrlCommand}" AutomationProperties.AutomationId="RenoDxOpenLink" Margin="0,0,10,10"
                                        Visibility="{Binding RenoDxExternalUrl, Converter={StaticResource StringNotEmptyToVis}}"/>
                            </WrapPanel>
                            <TextBlock Text="{Binding RenoDxEngineDetectionText}" Style="{StaticResource FsSectionStatus}" Margin="0,0,0,4"/>
                            <WrapPanel>
                                <Button Content="Unreal Engine, generic" Style="{StaticResource FsButton}" Command="{Binding RenoDxInstallUnrealGenericCommand}" AutomationProperties.AutomationId="RenoDxInstallUnrealGeneric" Margin="0,0,10,10"
                                        IsEnabled="{Binding CanInstallUnrealRenoDx}" Visibility="{Binding CanInstallUnrealRenoDx, Converter={StaticResource BoolToVis}}"/>
                                <Button Content="Unreal Engine, UE-Extended" Style="{StaticResource FsButton}" Command="{Binding RenoDxInstallUnrealUeExtendedCommand}" AutomationProperties.AutomationId="RenoDxInstallUnrealUeExtended" Margin="0,0,10,10"
                                        IsEnabled="{Binding CanInstallUnrealRenoDx}" Visibility="{Binding CanInstallUnrealRenoDx, Converter={StaticResource BoolToVis}}"/>
                                <Button Content="Unity, generic" Style="{StaticResource FsButton}" Command="{Binding RenoDxInstallUnityCommand}" AutomationProperties.AutomationId="RenoDxInstallUnity" Margin="0,0,10,10"
                                        IsEnabled="{Binding CanInstallUnityRenoDx}" Visibility="{Binding CanInstallUnityRenoDx, Converter={StaticResource BoolToVis}}"/>
                            </WrapPanel>
                        </StackPanel>

                        <Border Grid.Column="1" Width="2" Background="#33FFFFFF" Margin="20,0"/>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Luma" Style="{StaticResource FsSectionTitle}"/>
                            <TextBlock Text="{Binding LumaStatus}" Style="{StaticResource FsSectionStatus}"/>
                            <WrapPanel>
                                <CheckBox Content="Installed" Style="{StaticResource FsToggle}" Margin="0,0,20,10"
                                          IsChecked="{Binding IsLumaInstalled, Mode=OneWay}"
                                          Checked="LumaToggle_Checked" Unchecked="LumaToggle_Unchecked"
                                          AutomationProperties.AutomationId="LumaToggle"/>
                                <Button Content="Check update" Style="{StaticResource FsButton}" Command="{Binding LumaUpdateCommand}" AutomationProperties.AutomationId="LumaCheckUpdate" Margin="0,0,10,10"/>
                            </WrapPanel>
                        </StackPanel>
                    </Grid>

                    <StackPanel Visibility="{Binding ShowDxvkSection, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="DXVK+Lilium HDR" Style="{StaticResource FsSectionTitle}"/>
                        <TextBlock Text="{Binding DxvkStatus}" Style="{StaticResource FsSectionStatus}"/>
                        <TextBlock Text="{Binding DxvkApiDetectionText}" Style="{StaticResource FsSectionStatus}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <CheckBox Content="Installed" Style="{StaticResource FsToggle}" Margin="0,0,20,0"
                                      IsChecked="{Binding IsDxvkInstalled, Mode=OneWay}"
                                      IsEnabled="{Binding CanToggleDxvk}"
                                      Checked="DxvkToggle_Checked" Unchecked="DxvkToggle_Unchecked"
                                      AutomationProperties.AutomationId="DxvkToggle"/>
                            <Button Content="Check update" Style="{StaticResource FsButton}" Command="{Binding DxvkUpdateCommand}" AutomationProperties.AutomationId="DxvkCheckUpdate"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="OptiScaler (AMD)" Style="{StaticResource FsSectionTitle}"/>
                    <TextBlock Text="{Binding OptiScalerStatus}" Style="{StaticResource FsSectionStatus}"/>
                    <TextBlock Text="{Binding OptiScalerWikiCompatText}" Style="{StaticResource FsSectionStatus}" AutomationProperties.AutomationId="OptiScalerWikiCompatText"/>
                    <TextBlock Text="Check the game's own graphics settings: if it already offers FSR or XeSS (any version), use 'has FSR/XeSS'. If it only offers DLSS, use 'DLSS-only game'."
                               Style="{StaticResource FsSectionStatus}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Install (DLSS-only game)" Style="{StaticResource FsButton}" Command="{Binding OptiScalerInstallDlssCommand}" AutomationProperties.AutomationId="OptiScalerInstallDlss"/>
                        <Button Content="Install (has FSR/XeSS)" Style="{StaticResource FsButton}" Command="{Binding OptiScalerInstallNoDlssCommand}" AutomationProperties.AutomationId="OptiScalerInstallNoDlss"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <!-- No Checked handler: disabled while not installed, so the only way in is
                             the variant buttons above; see OptiScalerToggle_Unchecked in the code-behind. -->
                        <CheckBox Content="Installed" Style="{StaticResource FsToggle}" Margin="0,0,20,0"
                                  IsChecked="{Binding IsOptiScalerInstalled, Mode=OneWay}"
                                  IsEnabled="{Binding IsOptiScalerInstalled}"
                                  Unchecked="OptiScalerToggle_Unchecked"
                                  AutomationProperties.AutomationId="OptiScalerToggle"/>
                        <Button Content="Check update" Style="{StaticResource FsButton}" Command="{Binding OptiScalerUpdateCommand}" AutomationProperties.AutomationId="OptiScalerCheckUpdate"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
