<UserControl x:Class="HdrUpscaleManager.UI.ManagerFullscreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:HdrUpscaleManager.UI">
    <!--
        Fullscreen-mode counterpart to ManagerView.xaml. Playnite's Fullscreen host window for
        plugin content (via IDialogsFactory.CreateWindow) renders chromeless/transparent, so this
        view supplies its own fully opaque backdrop and a hardcoded high-contrast palette rather
        than any theme DynamicResource — same approach validated in playnite-eden-mod-manager's
        Fullscreen view, reused here rather than re-deriving a new untested palette.

        Gamepad: real WPF Button/CheckBox controls get D-pad-as-arrow-keys focus movement for
        free from Playnite's Fullscreen input layer. What's still needed by hand: setting initial
        focus on Loaded (the host doesn't do it), auto-scrolling the focused control into view on
        arrow keys (nothing does this by default), and routing gamepad A/B — which arrive via
        GenericPlugin.OnControllerButtonStateChanged, not as WPF key events — through
        FocusActivation (see ManagerFullscreenView.xaml.cs and HdrUpscaleManagerPlugin.cs).
    -->
    <UserControl.Resources>
        <local:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVis"/>

        <Style x:Key="FsButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="#FF2A2E36" BorderBrush="#33FFFFFF" BorderThickness="2" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#FFE0BE79"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FF383D47"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FsToggle" TargetType="CheckBox">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Bg" Background="#FF23262C" BorderBrush="Transparent" BorderThickness="3" CornerRadius="10" Padding="16,10">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="Check" Width="22" Height="22" BorderThickness="2" BorderBrush="#88FFFFFF" CornerRadius="4" Margin="0,0,12,0">
                                    <Path x:Name="CheckMark" Data="M2,8 L7,13 L16,3" Stroke="#FF6FCF7A" StrokeThickness="3" Visibility="Collapsed"/>
                                </Border>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FF2A3F2E"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#FF6FCF7A"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#FFE0BE79"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FsSectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="FsSectionStatus" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="#CCFFFFFF"/>
            <Setter Property="Margin" Value="0,4,0,12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Resources>

    <Border Background="#FF15171B" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="15">
        <Grid Margin="36">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="{Binding GameName}" FontSize="32" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                <TextBlock Text="  •  HDR &amp; Upscale Manager" FontSize="18" Foreground="#88FFFFFF" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                <TextBlock Text="A: confirm    •    B: close" Foreground="#88FFFFFF" FontSize="16"
                           VerticalAlignment="Center" Margin="28,0,0,0"/>
            </StackPanel>

            <TextBlock Grid.Row="1" Text="{Binding StatusText}" Foreground="#FFE0BE79" FontSize="19" Margin="0,0,0,16" TextWrapping="Wrap"/>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="ReShade" Style="{StaticResource FsSectionTitle}"/>
                    <TextBlock Text="{Binding ReShadeStatus}" Style="{StaticResource FsSectionStatus}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <Button Content="Install latest" Style="{StaticResource FsButton}" Command="{Binding ReShadeInstallCommand}"/>
                    </StackPanel>

                    <TextBlock Text="RenoDX" Style="{StaticResource FsSectionTitle}"/>
                    <TextBlock Text="{Binding RenoDxStatus}" Style="{StaticResource FsSectionStatus}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <Button Content="Install" Style="{StaticResource FsButton}" Command="{Binding RenoDxInstallCommand}"/>
                        <Button Content="Check update" Style="{StaticResource FsButton}" Command="{Binding RenoDxUpdateCommand}"/>
                        <Button Content="Uninstall" Style="{StaticResource FsButton}" Command="{Binding RenoDxUninstallCommand}"/>
                        <Button Content="Open link" Style="{StaticResource FsButton}" Command="{Binding OpenRenoDxExternalUrlCommand}"
                                Visibility="{Binding RenoDxExternalUrl, Converter={StaticResource StringNotEmptyToVis}}"/>
                    </StackPanel>

                    <TextBlock Text="Luma" Style="{StaticResource FsSectionTitle}"/>
                    <TextBlock Text="{Binding LumaStatus}" Style="{StaticResource FsSectionStatus}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <Button Content="Install" Style="{StaticResource FsButton}" Command="{Binding LumaInstallCommand}"/>
                        <Button Content="Check update" Style="{StaticResource FsButton}" Command="{Binding LumaUpdateCommand}"/>
                        <Button Content="Uninstall" Style="{StaticResource FsButton}" Command="{Binding LumaUninstallCommand}"/>
                    </StackPanel>

                    <TextBlock Text="DXVK+Lilium HDR" Style="{StaticResource FsSectionTitle}"/>
                    <TextBlock Text="{Binding DxvkStatus}" Style="{StaticResource FsSectionStatus}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <Button Content="Install (DX9/DX10)" Style="{StaticResource FsButton}" Command="{Binding DxvkInstallCommand}"/>
                        <Button Content="Check update" Style="{StaticResource FsButton}" Command="{Binding DxvkUpdateCommand}"/>
                        <Button Content="Uninstall" Style="{StaticResource FsButton}" Command="{Binding DxvkUninstallCommand}"/>
                    </StackPanel>

                    <TextBlock Text="OptiScaler (AMD)" Style="{StaticResource FsSectionTitle}"/>
                    <TextBlock Text="{Binding OptiScalerStatus}" Style="{StaticResource FsSectionStatus}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Install (DLSS-only game)" Style="{StaticResource FsButton}" Command="{Binding OptiScalerInstallDlssCommand}"/>
                        <Button Content="Install (has FSR/XeSS)" Style="{StaticResource FsButton}" Command="{Binding OptiScalerInstallNoDlssCommand}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <Button Content="Check update" Style="{StaticResource FsButton}" Command="{Binding OptiScalerUpdateCommand}"/>
                        <Button Content="Uninstall" Style="{StaticResource FsButton}" Command="{Binding OptiScalerUninstallCommand}"/>
                    </StackPanel>

                    <TextBlock Text="OS HDR toggle on launch/exit" Style="{StaticResource FsSectionTitle}"/>
                    <TextBlock Text="Unverified — validate on your own display before relying on it (see PLAN.md)."
                               Style="{StaticResource FsSectionStatus}"/>
                    <CheckBox Content="Enable for this game" Style="{StaticResource FsToggle}" IsChecked="{Binding HdrToggleEnabled}" Margin="0,0,0,20"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
