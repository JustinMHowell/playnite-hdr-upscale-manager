*_wpftmp.csproj

# Test results / coverage
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.coverage
*.coveragexml
coverage*.json
coverage*.xml
coverage*.info

# Windows / OS junk
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.stackdump
[Dd]esktop.ini
.DS_Store

# Publish output
publish/
PublishProfiles/*.user

# Playnite plugin packaging (built .pext / staging output)
*.pext
dist/

# UI test diagnostics (screenshots captured on timeout/failure) — local debugging aid only
TestScreenshots/

# Local reference clone of upstream RankFTW/RHI (research material only — GPL-3.0 source kept
