<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Deliberately standalone: no ProjectReference to HdrUpscaleManager.csproj, and nothing in
    the addon or its build (build-and-run.ps1, .github/workflows/build.yaml) references this
    project back. FlaUI is a dependency of this test project only, never of the shipped addon.
    See README.md in this folder before running.
  -->

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <RootNamespace>HdrUpscaleManager.UiTests</RootNamespace>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="FlaUI.Core" Version="4.0.0" />
    <PackageReference Include="FlaUI.UIA3" Version="4.0.0" />
    <!-- Only used to patch config.json's AccessibilityInterface field — see
         PlayniteConfigAccessibility.cs. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <!-- stopOnFail: true (see xunit.runner.json) — a failing test aborts the whole run instead of
       continuing to launch/kill Playnite through the rest of the suite. Especially valuable
       here: these tests are slow (each relaunches Playnite) and mutate real state (installs,
       game folders) — stopping immediately means less time spent, and less state to clean up,
       once something's already known to be broken. -->
  <ItemGroup>
    <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
